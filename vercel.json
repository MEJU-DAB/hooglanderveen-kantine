{
  "crons": [
    {
      "path": "/api/cron/rss",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/:path*.(jpg|jpeg|png|webp|svg|ico|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
